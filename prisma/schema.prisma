generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  NEQUI
  DAVIPLATA
  PAYPAL
  OTHER
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  creditCards           CreditCard[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  reminders             Reminder[]
  accountReceivables    AccountReceivable[]
}

enum ReceivableStatus {
  ACTIVE
  PAID
  DEFAULTED
  CANCELLED
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("COP")
  color     String      @default("#6366f1")
  icon      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  receivablesDisbursed AccountReceivable[] @relation("DisbursementAccount")
  receivablePayments   ReceivablePayment[] @relation("CollectionAccount")

  @@index([userId])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  icon      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String?
  categoryId    String
  creditCardId  String?
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  paymentMethod PaymentMethod   @default(DEBIT)
  installments  Int             @default(1)
  tags          String[]        @default([])
  attachmentUrl String?
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([creditCardId])
}

model CreditCard {
  id             String   @id @default(cuid())
  userId         String
  bank           String
  name           String
  lastFourDigits String
  creditLimit    Decimal  @db.Decimal(12, 2)
  usedBalance    Decimal  @default(0) @db.Decimal(12, 2)
  interestRate   Decimal  @default(0) @db.Decimal(5, 2)
  cutOffDate     Int
  paymentDueDate Int
  color          String   @default("#8b5cf6")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  savedAmount   Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  color         String    @default("#10b981")
  icon          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReminderType {
  CARD_PAYMENT
  CARD_CUTOFF
  BILL
  SUBSCRIPTION
  GOAL
  CUSTOM
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  type        ReminderType
  dueDate     DateTime
  isRead      Boolean      @default(false)
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

model AccountReceivable {
  id                 String           @id @default(cuid())
  userId             String
  debtorName         String
  principalAmount    Decimal          @db.Decimal(12, 2)
  outstandingBalance Decimal          @db.Decimal(12, 2)
  interestRate       Decimal          @default(0) @db.Decimal(5, 2)
  loanDate           DateTime
  status             ReceivableStatus @default(ACTIVE)
  sourceAccountId    String
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount Account             @relation("DisbursementAccount", fields: [sourceAccountId], references: [id])
  payments      ReceivablePayment[]

  @@index([userId, status])
  @@index([sourceAccountId])
}

model ReceivablePayment {
  id                   String   @id @default(cuid())
  receivableId         String
  amount               Decimal  @db.Decimal(12, 2)
  paymentDate          DateTime
  destinationAccountId String
  notes                String?
  createdAt            DateTime @default(now())

  receivable         AccountReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  destinationAccount Account           @relation("CollectionAccount", fields: [destinationAccountId], references: [id])

  @@index([receivableId])
  @@index([destinationAccountId])
}
