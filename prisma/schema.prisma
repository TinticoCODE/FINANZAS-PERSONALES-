generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  /// Pago a tarjeta: requiere cuenta origen (accountId) y tarjeta destino (creditCardId).
  PAYMENT_TO_CARD
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  NEQUI
  DAVIPLATA
  PAYPAL
  OTHER
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  /// Zona horaria IANA usada para ciclos de facturación, tareas recurrentes y formato en la interfaz.
  timezone  String   @default("America/Bogota")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  creditCards           CreditCard[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  reminders             Reminder[]
  loans                 Loan[]
  businesses            Business[]
  capitalTransfers      CapitalTransfer[]
  recurringTransactions RecurringTransaction[]
  creditCardStatements  CreditCardStatement[]
  monthlySnapshots      MonthlySnapshot[]
}

enum ReceivableStatus {
  ACTIVE
  PAID
  DEFAULTED
  CANCELLED
}

enum InterestType {
  FLAT
  MONTHLY
  ANNUAL
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("COP")
  color     String      @default("#6366f1")
  icon      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  recurringTransactions RecurringTransaction[]
  loansDisbursed       Loan[]         @relation("DisbursementAccount")
  loanPayments         LoanPayment[]  @relation("CollectionAccount")
  capitalTransfers     CapitalTransfer[]
  installmentPayments  InstallmentPayment[]

  @@index([userId])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  icon      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String?
  categoryId    String
  creditCardId  String?
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  paymentMethod PaymentMethod   @default(DEBIT)
  installments  Int             @default(1)
  /// Cuota vigente al registrar (inmutable; p. ej. extracto dice 2 de 6).
  currentInstallment Int        @default(1)
  /// Compra diferida a cuotas (MSI o con interés).
  isInstallments    Boolean     @default(false)
  /// Cuota mensual fija (principal/N en MSI; amortización en diferido con interés).
  installmentAmount Decimal?    @db.Decimal(12, 2)
  /// Meses sin intereses (3, 6, 9) — excluye la compra del cálculo de intereses punitorios.
  hasZeroInterest   Boolean     @default(false)
  tags          String[]        @default([])
  /// Agrupa las dos patas de partida doble (cuenta origen + tarjeta destino).
  transferGroupId String?
  attachmentUrl String?
  /// Almacenado en UTC (marca de tiempo con zona). El significado de negocio se interpreta en la zona horaria del usuario.
  date          DateTime        @default(now()) @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([creditCardId])
  @@index([transferGroupId])
}

model CreditCard {
  id             String   @id @default(cuid())
  userId         String
  bank           String
  name           String
  lastFourDigits String
  creditLimit    Decimal  @db.Decimal(12, 2)
  usedBalance    Decimal  @default(0) @db.Decimal(12, 2)
  interestRate   Decimal  @default(0) @db.Decimal(5, 2)
  cutOffDate     Int
  paymentDueDate Int
  color          String   @default("#8b5cf6")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  statements   CreditCardStatement[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Plantilla de movimiento automático. próxima ejecución siempre en UTC.
model RecurringTransaction {
  id             String              @id @default(cuid())
  userId         String
  accountId      String?
  creditCardId   String?
  categoryId     String
  type           TransactionType
  amount         Decimal             @db.Decimal(12, 2)
  description    String?
  frequency      RecurrenceFrequency
  /// Día del mes (1-31) para frecuencia mensual/anual. Se ajusta al último día si el mes es corto.
  dayOfMonth     Int?
  /// 0=domingo … 6=sábado para frecuencia semanal
  dayOfWeek      Int?
  /// 1-12 para frecuencia anual
  monthOfYear    Int?
  paymentMethod  PaymentMethod       @default(DEBIT)
  installments   Int                 @default(1)
  /// Próxima ejecución programada (UTC). La tarea programada compara contra el reloj del usuario.
  nextRunAt      DateTime            @db.Timestamptz(3)
  lastRunAt      DateTime?           @db.Timestamptz(3)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])

  @@index([userId, isActive, nextRunAt])
  @@index([nextRunAt])
}

/// Extracto / cierre de ciclo de facturación (idempotencia por fin de ciclo).
model CreditCardStatement {
  id                 String   @id @default(cuid())
  userId             String
  creditCardId       String
  cycleStart         DateTime @db.Timestamptz(3)
  cycleEnd           DateTime @db.Timestamptz(3)
  closedAt           DateTime @default(now()) @db.Timestamptz(3)
  usedBalanceAtClose Decimal  @db.Decimal(12, 2)
  totalPaymentDue    Decimal? @db.Decimal(12, 2)
  minPaymentDue      Decimal? @db.Decimal(12, 2)
  interestCharged    Decimal? @db.Decimal(12, 2)
  importSource       String?
  sourceFileHash     String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, cycleEnd])
  @@unique([creditCardId, sourceFileHash])
  @@index([userId, closedAt])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  savedAmount   Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  color         String    @default("#10b981")
  icon          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReminderType {
  CARD_PAYMENT
  CARD_CUTOFF
  BILL
  SUBSCRIPTION
  GOAL
  CUSTOM
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  type        ReminderType
  dueDate     DateTime     @db.Timestamptz(3)
  isRead      Boolean      @default(false)
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

model Loan {
  id                   String           @id @default(cuid())
  userId               String
  debtorName           String
  principalAmount      Decimal          @db.Decimal(12, 2)
  outstandingBalance   Decimal          @db.Decimal(12, 2)
  interestRate         Decimal          @default(0) @db.Decimal(5, 2)
  interestType         InterestType     @default(FLAT)
  expectedReturnAmount Decimal          @default(0) @db.Decimal(12, 2)
  loanDate             DateTime
  dueDate              DateTime         @default(now())
  status               ReceivableStatus @default(ACTIVE)
  sourceAccountId      String
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount Account       @relation("DisbursementAccount", fields: [sourceAccountId], references: [id])
  payments      LoanPayment[]

  @@index([userId, status])
  @@index([sourceAccountId])
  @@map("AccountReceivable")
}

model LoanPayment {
  id                   String   @id @default(cuid())
  loanId               String   @map("receivableId")
  amount               Decimal  @db.Decimal(12, 2)
  principalPaid        Decimal  @default(0) @db.Decimal(12, 2)
  interestPaid         Decimal  @default(0) @db.Decimal(12, 2)
  paymentDate          DateTime
  destinationAccountId String
  notes                String?
  createdAt            DateTime @default(now())

  loan               Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  destinationAccount Account @relation("CollectionAccount", fields: [destinationAccountId], references: [id])

  @@index([loanId])
  @@index([destinationAccountId])
  @@map("ReceivablePayment")
}

/// Cierre mensual inmutable — patrimonio e ingresos/gastos consolidados por mes.
model MonthlySnapshot {
  id                String   @id @default(cuid())
  userId            String
  month             Int
  year              Int
  totalAssets       Decimal  @db.Decimal(14, 2)
  totalLiabilities  Decimal  @db.Decimal(14, 2)
  totalIncome       Decimal  @db.Decimal(14, 2)
  totalExpense      Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year])
}

// ─── Libro mayor comercial (aislado del libro mayor personal) ─────────────

enum BusinessType {
  RETAIL
  MANUFACTURING
  SERVICE
}

enum BusinessStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum CapitalTransferType {
  OWNER_INVESTMENT
  OWNER_WITHDRAWAL
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InstallmentStatus {
  PENDING
  CURRENT
  OVERDUE
  PAID
  PARTIAL
  CANCELLED
}

enum CustomerRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum SalePaymentTerms {
  CASH
  CREDIT_INSTALLMENTS
  MIXED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum BusinessTransactionType {
  CAPITAL_INJECTION
  SUPPLIER_PURCHASE
  CASH_SALE
  CREDIT_SALE
  INSTALLMENT_PAYMENT
  OPERATING_EXPENSE
  OWNER_WITHDRAWAL
}

enum SupplierPayableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model BusinessSupplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payables SupplierPayable[]

  @@unique([businessId, name])
  @@index([businessId])
}

model SupplierPayable {
  id              String                @id @default(cuid())
  businessId      String
  supplierId      String?
  supplierName    String
  description     String
  totalAmount     Decimal               @db.Decimal(12, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(12, 2)
  dueDate         DateTime?
  status          SupplierPayableStatus @default(OPEN)
  journalEntryId  String                @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     BusinessSupplier?      @relation(fields: [supplierId], references: [id])
  journalEntry BusinessJournalEntry   @relation(fields: [journalEntryId], references: [id])
  transactions BusinessTransaction[]

  @@index([businessId, status])
  @@index([supplierId])
}

model BusinessTransaction {
  id                   String                  @id @default(cuid())
  businessId           String
  type                 BusinessTransactionType
  amount               Decimal                 @db.Decimal(12, 2)
  cashEffect           Decimal                 @default(0) @db.Decimal(12, 2)
  transactionDate      DateTime
  description          String
  journalEntryId       String                  @unique
  supplierPayableId    String?
  saleId               String?
  capitalTransferId    String?                 @unique
  installmentPaymentId String?                 @unique
  expenseId            String?                 @unique
  createdAt            DateTime                @default(now())

  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntry       BusinessJournalEntry    @relation(fields: [journalEntryId], references: [id])
  supplierPayable    SupplierPayable?        @relation(fields: [supplierPayableId], references: [id])
  sale               BusinessSale?           @relation(fields: [saleId], references: [id])
  capitalTransfer    CapitalTransfer?        @relation(fields: [capitalTransferId], references: [id])
  installmentPayment InstallmentPayment?     @relation(fields: [installmentPaymentId], references: [id])
  expense            BusinessExpense?        @relation(fields: [expenseId], references: [id])

  @@index([businessId, type])
  @@index([businessId, transactionDate])
}

model Business {
  id           String         @id @default(cuid())
  userId       String
  name         String
  slug         String
  businessType BusinessType   @default(RETAIL)
  status       BusinessStatus @default(ACTIVE)
  currency     String         @default("COP")
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerAccounts     BusinessLedgerAccount[]
  capitalTransfers   CapitalTransfer[]
  customers          BusinessCustomer[]
  products           BusinessProduct[]
  inventoryItems     InventoryItem[]
  sales              BusinessSale[]
  expenses           BusinessExpense[]
  expenseCategories  BusinessExpenseCategory[]
  journalEntries     BusinessJournalEntry[]
  businessTransactions BusinessTransaction[]
  businessSuppliers  BusinessSupplier[]
  supplierPayables   SupplierPayable[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model BusinessLedgerAccount {
  id         String            @id @default(cuid())
  businessId String
  code       String
  name       String
  type       LedgerAccountType
  isSystem   Boolean           @default(false)
  createdAt  DateTime          @default(now())

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    BusinessJournalLine[]

  @@unique([businessId, code])
  @@index([businessId, type])
}

model CapitalTransfer {
  id                String              @id @default(cuid())
  businessId        String
  userId            String
  type              CapitalTransferType
  amount            Decimal             @db.Decimal(12, 2)
  transferDate      DateTime
  personalAccountId String
  journalEntryId    String              @unique
  notes             String?
  createdAt         DateTime            @default(now())

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalAccount Account              @relation(fields: [personalAccountId], references: [id])
  journalEntry    BusinessJournalEntry @relation(fields: [journalEntryId], references: [id])
  businessTransaction BusinessTransaction?

  @@index([businessId, transferDate])
  @@index([personalAccountId])
}

model BusinessCustomer {
  id               String            @id @default(cuid())
  businessId       String
  name             String
  documentId       String?
  phone            String?
  email            String?
  address          String?
  riskLevel        CustomerRiskLevel @default(LOW)
  overdueDaysMax   Int               @default(0)
  totalSales       Decimal           @default(0) @db.Decimal(12, 2)
  totalOutstanding Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    BusinessSale[]

  @@index([businessId, riskLevel])
  @@index([businessId, name])
}

model BusinessProduct {
  id                 String   @id @default(cuid())
  businessId         String
  sku                String?
  name               String
  description        String?
  unit               String   @default("und")
  salePrice          Decimal  @db.Decimal(12, 2)
  supplierName       String?
  supplierPhone      String?
  supplierWhatsApp   String?
  supplierEmail      String?
  isInventoryTracked Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  saleLines      BusinessSaleLine[]

  @@index([businessId, isActive])
}

model InventoryItem {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  quantity      Decimal  @db.Decimal(12, 3)
  unitCost      Decimal  @db.Decimal(12, 2)
  lastRestocked DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   BusinessProduct     @relation(fields: [productId], references: [id])
  movements InventoryMovement[]

  @@unique([businessId, productId])
  @@index([businessId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(12, 3)
  unitCost        Decimal               @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  movementDate    DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, movementDate])
}

model BusinessSale {
  id             String           @id @default(cuid())
  businessId     String
  customerId     String?
  saleNumber     String
  saleDate       DateTime
  paymentTerms   SalePaymentTerms
  subtotal       Decimal          @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal          @db.Decimal(12, 2)
  cashReceived   Decimal          @default(0) @db.Decimal(12, 2)
  cogsTotal      Decimal          @default(0) @db.Decimal(12, 2)
  journalEntryId String           @unique
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     BusinessCustomer?    @relation(fields: [customerId], references: [id])
  journalEntry BusinessJournalEntry @relation(fields: [journalEntryId], references: [id])
  lines        BusinessSaleLine[]
  installments SaleInstallment[]
  businessTransactions BusinessTransaction[]

  @@unique([businessId, saleNumber])
  @@index([businessId, saleDate])
  @@index([customerId])
}

model BusinessSaleLine {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  sale    BusinessSale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product BusinessProduct? @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model SaleInstallment {
  id              String            @id @default(cuid())
  saleId          String
  installmentNo   Int
  dueDate         DateTime
  expectedAmount  Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(12, 2)
  status          InstallmentStatus @default(PENDING)
  overdueDays     Int               @default(0)
  paidAt          DateTime?
  lastPaymentDate DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sale     BusinessSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments InstallmentPayment[]

  @@unique([saleId, installmentNo])
  @@index([dueDate, status])
  @@index([status])
}

model InstallmentPayment {
  id                    String   @id @default(cuid())
  installmentId         String
  amount                Decimal  @db.Decimal(12, 2)
  paymentDate           DateTime
  journalEntryId        String   @unique
  destinationAccountId  String?
  notes                 String?

  installment         SaleInstallment      @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  journalEntry        BusinessJournalEntry @relation(fields: [journalEntryId], references: [id])
  destinationAccount  Account?             @relation(fields: [destinationAccountId], references: [id])
  businessTransaction BusinessTransaction?

  @@index([installmentId])
  @@index([destinationAccountId])
}

model BusinessExpenseCategory {
  id         String @id @default(cuid())
  businessId String
  name       String
  color      String @default("#6366f1")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses BusinessExpense[]

  @@unique([businessId, name])
}

model BusinessExpense {
  id             String   @id @default(cuid())
  businessId     String
  categoryId     String
  amount         Decimal  @db.Decimal(12, 2)
  expenseDate    DateTime
  description    String?
  journalEntryId String   @unique
  createdAt      DateTime @default(now())

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     BusinessExpenseCategory @relation(fields: [categoryId], references: [id])
  journalEntry BusinessJournalEntry    @relation(fields: [journalEntryId], references: [id])
  businessTransaction BusinessTransaction?

  @@index([businessId, expenseDate])
}

model BusinessJournalEntry {
  id          String   @id @default(cuid())
  businessId  String
  entryDate   DateTime
  description String
  reference   String?
  createdAt   DateTime @default(now())

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines           BusinessJournalLine[]
  sale            BusinessSale?
  expense         BusinessExpense?
  capitalTransfer CapitalTransfer?
  installmentPay  InstallmentPayment?
  businessTransaction BusinessTransaction?
  supplierPayable SupplierPayable?

  @@index([businessId, entryDate])
}

model BusinessJournalLine {
  id              String  @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  debit           Decimal @default(0) @db.Decimal(12, 2)
  credit          Decimal @default(0) @db.Decimal(12, 2)

  journalEntry  BusinessJournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount BusinessLedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([journalEntryId])
  @@index([ledgerAccountId])
}
