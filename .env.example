# ─── Base de datos ───────────────────────────────────────────
# Local (Docker — ver docker-compose.yml)
DATABASE_URL="postgresql://finance:finance123@localhost:5432/personal_finance?schema=public"

# Producción (Neon) — usa el endpoint POOLER (-pooler) para menos CU-hours:
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# La app añade automáticamente connection_limit=1 y pool_timeout=0 si detecta neon.tech

# ─── Autenticación admin ─────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Pedro999@"
# Generar uno seguro en producción: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
